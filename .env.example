# ---------------------------------------------------------------------------
# Copy to .env and fill in real values.  Never commit .env.
# ---------------------------------------------------------------------------

# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inkwell?schema=public"

# Direct (non-pooled) connection used by Prisma Migrate.
# On Neon/Supabase this differs from DATABASE_URL. Locally, keep them identical.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/inkwell?schema=public"

# Signing key for session JWTs. MUST be at least 32 characters.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-random-48-byte-base64url-string"
